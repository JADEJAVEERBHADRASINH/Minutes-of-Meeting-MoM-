@model IEnumerable<MOM.Models.MeetingModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Meeting List</h3>

    <div class="d-flex gap-2">
        <a asp-action="ExportToExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </a>

        <a asp-action="MeetingAddEdit" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add
        </a>
    </div>
</div>
<hr />

<!---search--->

<div class="card-body pb-0">

    <form asp-action="MeetingList" method="post" class="mb-3">

        <div class="row g-2 align-items-center">

            <div class="col-md-4">
                <input type="text"
                       name="SearchText"
                       value="@ViewBag.SearchText"
                       class="form-control"
                       placeholder="Search Meeting..." />
            </div>

            <div class="col-auto">

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-action="MeetingList" class="btn btn-secondary">
                    Reset
                </a>

            </div>

        </div>

    </form>

</div>
<table class="table table-striped table-hover">

    <thead>
        <tr>
            <th>MeetingID</th>
            <th>Date</th>
            <th>Venue</th>
            <th>Type</th>
            <th>Department</th>
            <th>Cancelled</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>

                    <td>@item.MeetingID</td>

                    <td>@(item.MeetingDate?.ToString("dd-MM-yyyy") ?? "-")</td>

                    <td>@item.MeetingVenueName</td>

                    <td>@item.MeetingTypeName</td>

                    <td>@item.DepartmentName</td>

                    <td>@(item.IsCancelled ? "Yes" : "No")</td>

                    <td>

                        <a asp-action="MeetingAddEdit"  asp-route-id="@item.MeetingID"  class="btn btn-outline-primary btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"  asp-route-MeetingID="@item.MeetingID" class="btn btn-outline-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    No Records Found
                </td>
            </tr>
        }

    </tbody>

</table>