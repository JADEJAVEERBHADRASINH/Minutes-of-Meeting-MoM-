@model MOM.Models.DepartmentModel

<div class="card">

    <div class="card-body">

        <h5 class="card-title">Add / Edit Department</h5>

        <form asp-action="Save" asp-controller="Department" method="post"
              class="row g-3">

          
            <input type="hidden" asp-for="DepartmentID" />


            <div class="col-12">

                <label asp-for="DepartmentName" class="form-label">
                    Department Name
                </label>

                <input asp-for="DepartmentName" class="form-control" placeholder="Enter Department Name" />

                <span asp-validation-for="DepartmentName" class="text-danger"></span>

            </div>

         

            <div class="text-center">

                <button type="submit" class="btn btn-primary">
                    Submit
                </button>

                <button type="reset" class="btn btn-secondary">
                    Reset
                </button>

                <a asp-controller="Department" asp-action="DepartmentList" class="btn btn-outline-danger">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}