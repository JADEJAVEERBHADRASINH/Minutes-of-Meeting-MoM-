@model IEnumerable<MOM.Models.MeetingMemberModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Meeting Member List</h3>

    <div class="d-flex gap-2">
        <a asp-action="ExportToExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </a>

        <a asp-action="MeetingMemberAddEdit" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add
        </a>
    </div>
</div>

<hr />

@if (TempData["SuccessMessage"] != null)
{
    <p class="text-success">@TempData["SuccessMessage"]</p>
}

@if (TempData["ErrorMessage"] != null)
{
    <p class="text-danger">@TempData["ErrorMessage"]</p>
}

<!-- search -->

<div class="card-body pb-0 mb-3">

    <form asp-action="MeetingMemberList" method="post">

        <div class="row g-2 align-items-center">

            <div class="col-md-4">

                <input type="text"
                       name="SearchText"
                       value="@ViewBag.SearchText"
                       class="form-control"
                       placeholder="Search Meeting Date..." />

            </div>

            <div class="col-auto">

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-action="MeetingMemberList" class="btn btn-secondary">
                    Reset
                </a>

            </div>

        </div>

    </form>

</div>

<table class="table table-striped">

    <thead>

        <tr>
            <th>ID</th>
            <th>Meeting Date</th>
            <th>Staff</th>
            <th>Status</th>
            <th>Remarks</th>
            <th>Action</th>
        </tr>

    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>

                    <td>@item.MeetingMemberID</td>

                    <td>@item.MeetingDate.ToString("dd-MM-yyyy")</td>

                    <td>@item.StaffName</td>

                    <td>

                        @if (item.IsPresent)
                        {
                            <span class="badge bg-success">Present</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Absent</span>
                        }

                    </td>

                    <td>@item.Remarks</td>
                    <td>

                        <a asp-action="MeetingMemberAddEdit"
                           asp-route-id="@item.MeetingMemberID"
                           class="btn btn-outline-primary btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-MeetingMemberID="@item.MeetingMemberID"
                           class="btn btn-outline-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No Records Found
                </td>
            </tr>
        }

    </tbody>

</table>