@model MOM.Models.MeetingMemberModel

<div class="pagetitle">
    <h1>Add / Edit Meeting Member</h1>
</div>

<hr />

<div class="card">
    <div class="card-body">

        
        <h5 class="card-title">Meeting Member Form</h5>

        <form asp-action="Save" method="post" class="row g-3">

           
            <input type="hidden" asp-for="MeetingMemberID" />

            <div class="col-12">
                <label class="form-label">Meeting</label>

                <select asp-for="MeetingID"
                        asp-items="ViewBag.MeetingList"
                        class="form-control">

                    <option value="">Select Meeting</option>

                </select>

                <span asp-validation-for="MeetingID" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label class="form-label">Staff</label>

                <select asp-for="StaffID"
                        asp-items="ViewBag.StaffList"
                        class="form-control">

                    <option value="">Select Staff</option>

                </select>

                <span asp-validation-for="StaffID" class="text-danger"></span>
            </div>

            <div class="col-12 form-check">
                <input asp-for="IsPresent" class="form-check-input" type="checkbox" />

                <label class="form-check-label">
                    Is Present
                </label>
            </div>

            <div class="col-12">
                <label class="form-label">Remarks</label>

                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="text-center">

                <button type="submit" class="btn btn-primary">
                    Save
                </button>

                <button type="reset" class="btn btn-secondary">
                    Reset
                </button>

                <a asp-action="MeetingMemberList"
                   class="btn btn-outline-danger">
                    Cancel
                </a>

            </div>

        </form>

    </div>
    

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
