@model MOM.Models.MeetingVenueModel

<div class="card">
    <div class="card-body">

        <h5 class="card-title">Add / Edit Meeting Venue</h5>

        <form asp-action="Save" asp-controller="MeetingVenue"method="post"class="row g-3">

            <input type="hidden" asp-for="MeetingVenueID" />

            <div class="col-12">

                <label asp-for="MeetingVenueName" class="form-label">
                    Meeting Venue Name
                </label>

                <input asp-for="MeetingVenueName" class="form-control" />

                <span asp-validation-for="MeetingVenueName" class="text-danger"></span>

            </div>

            <div class="text-center">

                <button type="submit"
                        class="btn btn-primary">
                    Submit
                </button>

                <a asp-action="MeetingVenueList" asp-controller="MeetingVenue" class="btn btn-outline-danger">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}