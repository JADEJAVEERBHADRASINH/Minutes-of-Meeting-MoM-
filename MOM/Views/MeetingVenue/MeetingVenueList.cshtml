@model IEnumerable<MOM.Models.MeetingVenueModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Meeting Venue List</h3>

    <div class="d-flex gap-2">
        <a asp-action="ExportToExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </a>

        <a asp-action="MeetingVenueAddEdit" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add
        </a>
    </div>
</div>

<hr />

@if (TempData["SuccessMessage"] != null)
{
    <p class="text-success">@TempData["SuccessMessage"]</p>
}

@if (TempData["ErrorMessage"] != null)
{
    <p class="text-danger">@TempData["ErrorMessage"]</p>
}

<!-- search -->

<div class="card-body pb-0">

    <form asp-action="MeetingVenueList" method="post" class="mb-3">

        <div class="row g-2 align-items-center">

            <div class="col-md-4">
                <input type="text"
                       name="SearchText"
                       value="@ViewBag.SearchText"
                       class="form-control"
                       placeholder="Search Venue..." />
            </div>

            <div class="col-auto">

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-action="MeetingVenueList"  class="btn btn-secondary">
                    Reset
                </a>

            </div>

        </div>

    </form>

</div>

<table class="table table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Venue Name</th>
            <th>Created</th>
            <th>Modified</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.MeetingVenueID</td>

                <td>@item.MeetingVenueName</td>

                <td>@item.Created</td>

                <td>@item.Modified</td>

                <td>

                    <a asp-action="MeetingVenueAddEdit" asp-route-id="@item.MeetingVenueID" class="btn btn-outline-primary btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete" asp-route-MeetingVenueID="@item.MeetingVenueID"  class="btn btn-outline-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>