@model MOM.Models.StaffModel

<h2>Staff Add Edit</h2>

<hr />

<form asp-action="Save" asp-controller="Staff" method="post">

    <input type="hidden" asp-for="StaffId" />


    <div class="mb-3">
        <label asp-for="StaffName" class="form-label">Staff Name</label>

        <input asp-for="StaffName" class="form-control" placeholder="Enter Staff Name" />

        <span asp-validation-for="StaffName" class="text-danger"></span>
    </div>


    <div class="row mb-3">

  
        <div class="col-md-4">

            <label asp-for="DepartmentID" class="form-label">
                Select Department
            </label>

            <select asp-for="DepartmentID"   class="form-control"  asp-items="ViewBag.DepartmentList">

                <option value="" selected disabled>
                    --- Select Department ---
                </option>

            </select>

        </div>

       

        <div class="col-md-4">

            <label asp-for="EmailAddress" class="form-label">
                Email
            </label>

            <input asp-for="EmailAddress"  class="form-control"  placeholder="Enter Email" />

            <span asp-validation-for="EmailAddress" class="text-danger"></span>

        </div>

    </div>



    <div class="mb-3">

        <label asp-for="MobileNo" class="form-label">
            Mobile No
        </label>

        <input asp-for="MobileNo"  class="form-control"  placeholder="Enter Mobile Number" />

        <span asp-validation-for="MobileNo" class="text-danger"></span>

    </div>




    <div class="mb-3">

        <label asp-for="Remarks" class="form-label">
            Remarks
        </label>

        <input asp-for="Remarks"   class="form-control" placeholder="Enter Remarks" />

        <span asp-validation-for="Remarks" class="text-danger"></span>

    </div>


   

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="StaffList" asp-controller="Staff" class="btn btn-secondary">
        Cancel
     </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}