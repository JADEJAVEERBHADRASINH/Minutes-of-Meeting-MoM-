@model MOM.Models.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <title>MOM Login</title>

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/style.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>

        body {
            background: #f6f9ff;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI";
        }

        .login-box {
            width: 450px;
            background: #ffffff;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(65,84,241,0.12);
            border: 1px solid #eef2ff;
        }

        .login-box {
            transition: 0.3s;
        }

            .login-box:hover {
                transform: translateY(-3px);
            }


        .title {
            font-size: 30px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .subtitle {
            font-size: 14px;
            color: #777;
            margin-bottom: 25px;
        }

        .form-control {
            height: 45px;
        }

        .btn-login {
            background: #4154f1;
            border: none;
            height: 45px;
            font-weight: 500;
        }

            .btn-login:hover {
                background: #3646d6;
            }

        .footer {
            text-align: center;
            font-size: 13px;
            margin-top: 20px;
            color: #777;
        }

    </style>

</head>

<body>

    <div class="login-box">

        
        <div class="title">
            Welcome back,
        </div>

        <div class="subtitle">
            Your MOM workspace is ready.
        </div>

        <form asp-action="Login" method="post">

            <label class="mb-1">Username</label>

            <input asp-for="UserName" class="form-control mb-3" placeholder="Enter username">

            <label class="mb-1">Password</label>

            <div class="input-group mb-3">

                <input asp-for="Password" type="password" class="form-control" id="password" placeholder="Enter password">

                <span class="input-group-text" onclick="togglePassword()"  style="cursor:pointer">

                    <i class="bi bi-eye" id="eyeIcon"></i>

                </span>

            </div>

            <button class="btn btn-login text-white w-100">
                Sign In
            </button>

        </form>

        <div class="footer">
            © Copyright MOM. All Rights Reserved
            Designed by Veerbhadrasinh Jadeja 

        </div>

    </div>

    <script>

        function togglePassword(){

        var p=document.getElementById("password");
        var icon=document.getElementById("eyeIcon");

        if(p.type==="password"){
        p.type="text";
        icon.classList.replace("bi-eye","bi-eye-slash");
        }else{
        p.type="password";
        icon.classList.replace("bi-eye-slash","bi-eye");
        }

        }

    </script>

</body>

</html>